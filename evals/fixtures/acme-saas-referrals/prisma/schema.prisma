generator client { provider = "prisma-client-js" }
datasource db { provider = "postgresql" url = env("DATABASE_URL") }

model User {
  id               String         @id @default(cuid())
  email            String         @unique
  emailVerified    DateTime?
  name             String?
  image            String?
  credits          Int            @default(0) // cached balance in cents; source of truth is CreditLedger
  referralCode     String?        @unique
  emailNormalized  String?        @unique
  stripeCustomerId String?        @unique
  createdAt        DateTime       @default(now())
  accounts         Account[]
  sessions         Session[]
  subscriptions    Subscription[]
  referralsMade    Referral[]     @relation("Referrer")
  referralReceived Referral?      @relation("Referee")
  creditLedger     CreditLedger[]
}

model Referral {
  id           String         @id @default(cuid())
  referrerId   String
  refereeId    String         @unique
  status       String // rewarded | referrer_capped | rejected
  rejectReason String?
  createdAt    DateTime       @default(now())
  referrer     User           @relation("Referrer", fields: [referrerId], references: [id])
  referee      User           @relation("Referee", fields: [refereeId], references: [id])
  ledger       CreditLedger[]

  @@index([referrerId, createdAt])
}

model CreditLedger {
  id          String    @id @default(cuid())
  userId      String
  amountCents Int
  reason      String
  role        String? // referrer | referee
  referralId  String?
  createdAt   DateTime  @default(now())
  user        User      @relation(fields: [userId], references: [id])
  referral    Referral? @relation(fields: [referralId], references: [id])

  @@unique([referralId, role])
  @@index([userId])
}

model Subscription {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  status    String
  priceId   String
  createdAt DateTime @default(now())
}

model Account {
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([provider, providerAccountId])
}

model Session {
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String
  expires    DateTime

  @@id([identifier, token])
}
