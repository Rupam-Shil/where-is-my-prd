#!/usr/bin/expect -f
# Drives a real, interactive Claude Code session for the README demo and logs a
# timestamp for every beat, so record.sh can fast-forward the waiting in the edit.
# Turn completion comes from Claude Code's own Stop hook, not from scraping the screen.
#
# Usage: expect demo.exp <plugin-dir> <workdir> <state-dir> <model>
#   <state-dir>/ready   written once Claude Code is idle and the screen is clean
#   <state-dir>/go      waited for before typing (the recorder is running by then)
#   <state-dir>/done    written after the last beat
#   <state-dir>/stopped waited for before quitting Claude Code

set plugin [lindex $argv 0]
set workdir [lindex $argv 1]
set state [lindex $argv 2]
set model [lindex $argv 3]

set prompt "add a referral system - users get a referral link, and when a friend signs up both of them get \$10 credit. ship it today pls"
set reply "defaults, but cap rewards at 5 per referrer per month. lock the spec, I'll review it before you build"

proc mark {name} {
  global state
  set f [open "$state/events.log" a]
  puts $f "[clock milliseconds] $name"
  close $f
}

# Keep echoing Claude Code's output to this terminal for <ms> milliseconds.
proc drain {ms} {
  set end [expr {[clock milliseconds] + $ms}]
  while {[clock milliseconds] < $end} {
    expect -timeout 0 -re {.+} {} eof { error "claude exited" }
    after 15
  }
}

proc wait_file {path} {
  while {![file exists $path]} { drain 200 }
}

proc turns_done {} {
  global state
  if {![file exists "$state/stops"]} { return 0 }
  set f [open "$state/stops"]
  set n [llength [regexp -all -inline {stop} [read $f]]]
  close $f
  return $n
}

proc type {text} {
  foreach ch [split $text ""] {
    send -- $ch
    drain [expr {35 + int(rand() * 55)}]
  }
}

proc ask {text n} {
  type $text
  drain 700
  send "\r"
  mark "submitted[expr {$n > 1 ? $n : {}}]"
  while {[turns_done] < $n} { drain 250 }
  mark "answered[expr {$n > 1 ? $n : {}}]"
}

set f [open "$state/claude-settings.json" w]
puts $f [format {{"hooks":{"SessionStart":[{"hooks":[{"type":"command","command":"touch '%s/session'"}]}],"Stop":[{"hooks":[{"type":"command","command":"echo stop >> '%s/stops'"}]}]}}} $state $state]
close $f

# Start from a blank screen and scrollback, and keep expect's own "spawn ..." echo off it.
send_user "\033\[H\033\[2J\033\[3J"
log_user 0
cd $workdir
spawn claude --plugin-dir $plugin --model $model --setting-sources project,local \
  --settings "$state/claude-settings.json" --allowedTools "Skill Write Edit Bash(date:*) Bash(sh:*) Bash(mkdir:*) Bash(ls:*)"
log_user 1

# Startup dialogs. Each is drained before answering, so one dialog is never answered twice.
#   Folder trust: the highlighted default is "No, exit", so move down to "Yes".
#   External CLAUDE.md imports (from a personal ~/.claude/CLAUDE.md): keep the default, "No".
expect {
  -timeout 25
  -re {I.{0,12}trust} { drain 800; send "\033\[B"; drain 300; send "\r"; exp_continue }
  -re {external.{0,12}imports} { drain 800; send "\r"; exp_continue }
  timeout {}
}
wait_file "$state/session"
drain 2500
send "/clear\r"
drain 2500
mark ready
close [open "$state/ready" w]
wait_file "$state/go"

mark typing
drain 800
ask $prompt 1
drain 11000
ask $reply 2
drain 9000

mark end
close [open "$state/done" w]
wait_file "$state/stopped"
send "\x03"
drain 400
send "\x03"
expect -timeout 10 eof
